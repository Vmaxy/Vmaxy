- name: Snake Evolution
  uses: miccy/snake-evolution@v1.3.0
  with:
    # Your GitHub username
    github_user_name: Vmaxy

    # Grants authenticated API access to prevent rate-limiting
    github_token: ${{ secrets.GITHUB_TOKEN }}

    # Path where the generated SVG will be saved
    outputs: dist/snake.svg

    # Color theme: github-light, github-dark, ocean, sunset, neon-gamer, cypherpunk
    theme: neon-gamer

    # Leave empty or omit to use the rolling last 12 months
    year: ""
